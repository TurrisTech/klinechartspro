{
  "name": "@klinecharts/pro",
  "version": "0.3.0",
  "description": "Financial chart built out of the box based on KLineChart.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/klinecharts-pro.cjs",
  "module": "./dist/klinecharts-pro.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/klinecharts-pro.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/klinecharts-pro.js",
      "require": "./dist/klinecharts-pro.cjs",
      "default": "./dist/klinecharts-pro.js"
    },
    "./style.css": "./dist/klinecharts-pro.css"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/klinecharts/pro"
  },
  "keywords": [
    "klinecharts",
    "pro",
    "candlestick",
    "finance",
    "stock",
    "chart",
    "canvas"
  ],
  "author": "liihuu",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "dev": "bun --hot examples/index.html",
    "dev:client": "bun --hot client/serve.ts",
    "dev:client:bg": "scripts/dev-client.sh",
    "build:client": "bun run scripts/build-client.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build-core": "bun run check && bun run scripts/build.ts",
    "build-dts": "bunx tsc -p tsconfig.build.json",
    "build": "bun run build-core && bun run build-dts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "bun run docs:build && gh-pages -d website"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@internationalized/date": "^3.12.0",
    "@types/bun": "^1.3.14",
    "bun-plugin-svelte": "^0.0.6",
    "gh-pages": "^6.3.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.26.0",
    "bits-ui": "^2.16.3",
    "svelte": "^5.39.0"
  },
  "peerDependencies": {
    "klinecharts": "^10.0.0"
  }
}
